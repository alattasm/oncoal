if barstate.islast
    table.clear(tb, 0, 0, 3, 40)
    table.cell(tb, 0, 0, preset, text_color = color.yellow, text_size = tblSize)
    table.cell(tb, 1, 0, "BUY setup", text_color = color.yellow, text_size = tblSize)
    table.cell(tb, 2, 0, "SELL setup", text_color = color.yellow, text_size = tblSize)
    table.cell(tb, 3, 0, "Last signal", text_color = color.yellow, text_size = tblSize)
    n = rName.size()
    if n == 0
        table.cell(tb, 0, 1, "No active setups right now", text_color = color.silver, text_size = tblSize)
    else
        for k = 0 to n - 1
            bt = rBuy.get(k)
            st = rSell.get(k)
            table.cell(tb, 0, k + 1, rName.get(k), text_color = color.white, text_size = tblSize)
            table.cell(tb, 1, k + 1, bt, text_color = bt == "BUY NOW" ? color.lime : color.silver, text_size = tblSize)
            table.cell(tb, 2, k + 1, st, text_color = st == "SELL NOW" ? color.red : color.silver, text_size = tblSize)
            table.cell(tb, 3, k + 1, rLast.get(k), text_color = rCol.get(k), text_size = tblSize)

if barstate.islast
    string head = "SMC + RSI " + preset + " (" + timeframe.period + ")\n"
    if dailyRep
        string body = str.length(msgs) > 0 ? "SIGNALS:\n" + msgs : "No buy/sell signal today.\n"
        body += rWatch.size() > 0 ? "Close to a signal: " + array.join(rWatch, ", ") : "Nothing close to a signal."
        alert(head + body, alert.freq_once_per_bar_close)
    else if str.length(msgs) > 0
        alert(head + msgs, alert.freq_once_per_bar_close)
