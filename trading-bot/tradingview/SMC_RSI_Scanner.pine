// Runs the SELL state machine. BUY = call it with the chart mirrored upside-down.
// Returns [signal, entry, stop, target, rsiDivergence, phase]
smc(float o, float h, float l, float c, float rs, float at) =>
    var array<int>   shI = array.new_int()
    var array<float> shP = array.new_float()
    var array<float> shR = array.new_float()
    var array<int>   slI = array.new_int()
    var array<float> slP = array.new_float()
    var int   phase    = 0      // 0 waiting, 1 swept, 2 CHoCH, 3 find FVG, 4 armed
    var int   start    = 0
    var int   chochBar = 0
    var int   bosBar   = 0
    var int   armedBar = 0
    var float sweepHi  = na
    var float protLow  = na
    var float fvgBot   = na
    var float fvgTop   = na
    var bool  rdiv     = false

    k  = swingLen
    t  = bar_index
    hh = ta.highest(h, 2 * k + 1)
    ll = ta.lowest(l, 2 * k + 1)

    bool  sig = false
    float e   = na
    float s   = na
    float tp  = na
    bool  dv  = false

    if t >= 2 * k
        // confirm the swing that is k bars old (no look-ahead)
        if h[k] == hh and h[k] > h[k + 1]
            shI.push(t - k)
            shP.push(h[k])
            shR.push(rs[k])
        if l[k] == ll and l[k] < l[k + 1]
            slI.push(t - k)
            slP.push(l[k])

        if phase == 0
            // 1) liquidity sweep of the latest unbroken swing high
            if shI.size() > 0 and slI.size() > 0
                sh = shP.last()
                sr = shR.last()
                if h > sh and c < sh
                    d = rs < sr      // price higher high, RSI lower high
                    shI.pop()
                    shP.pop()
                    shR.pop()
                    if not (reqDiv and not d)
                        phase   := 1
                        start   := t
                        sweepHi := h
                        protLow := slP.last()
                        rdiv    := d
                else if c > sh
                    shI.pop()
                    shP.pop()
                    shR.pop()
        else
            bool alive = true
            if t - start > maxSetup or c > sweepHi
                phase := 0
                alive := false

            if alive and phase == 1
                sweepHi := math.max(sweepHi, h)
                if c < protLow
                    // 2) CHoCH
                    phase    := 2
                    chochBar := t
                    if not reqBos
                        phase  := 3
                        bosBar := t
                else
                    alive := false

            if alive and phase == 2 and t > chochBar
                // 3) BOS: lower high after CHoCH, then close below the leg low
                int lhI = -1
                n = shI.size()
                if n > 0
                    for q = n - 1 to 0
                        if shI.get(q) <= chochBar
                            break
                        if shP.get(q) < sweepHi
                            lhI := shI.get(q)
                            break
                if lhI >= 0
                    float ref = l[t - start]
                    for m = start to lhI
                        ref := math.min(ref, l[t - m])
                    if c < ref
                        phase  := 3
                        bosBar := t

            if alive and phase == 3
                // 4) most recent bearish FVG in the impulsive leg
                bool found = false
                if bosBar >= start + 2
                    for i = bosBar to start + 2
                        if l[t - (i - 2)] > h[t - i]
                            fvgBot := h[t - i]
                            fvgTop := l[t - (i - 2)]
                            found  := true
                            break
                if found
                    phase    := 4
                    armedBar := t
                else
                    phase := 0
                alive := false

            if alive and phase == 4 and t > armedBar
                if c > fvgTop
                    phase := 0     // 7) closed above the gap: cancelled
                else if h >= fvgBot and c < fvgBot and c < o
                    // 5) back into the gap, rejected, closed below it
                    e := c
                    s := sweepHi + slBuf * at
                    risk = s - e
                    phase := 0
                    if risk > 0 and risk <= maxRiskAtr * at
                        sig := true
                        tp  := e - rr * risk
                        dv  := rdiv
    [sig, e, s, tp, dv, phase]

// Runs both directions on the requested symbol.
scan() =>
    r = ta.rsi(close, rsiLen)
    a = ta.atr(atrLen)
    [sSig, sE, sSL, sTP, sDiv, sPh] = smc(open, high, low, close, r, a)
    [bSig, bE, bSL, bTP, bDiv, bPh] = smc(-open, -low, -high, -close, 100 - r, a)
    [bSig, -bE, -bSL, -bTP, sSig, sE, sSL, sTP, bPh, sPh, time]

phaseText(int p) =>
    na(p) ? "n/a" : p == 0 ? "waiting" : p == 1 ? "sweep" : p == 2 ? "CHoCH" : p == 3 ? "BOS" : "FVG retrace"

fmt(float x) => str.tostring(x, "#.##")

shortName(string sym) =>
    parts = str.split(sym, ":")
    parts.size() > 1 ? parts.get(1) : sym

var table tb = table.new(tblPos, 4, 41, bgcolor = color.new(color.black, 15), border_width = 1)
var array<string> lastTxt = array.new_string(40, "-")
var array<int>    lastBar = array.new_int(40, na)
var array<string> rName = array.new_string()
var array<string> rBuy  = array.new_string()
var array<string> rSell = array.new_string()
var array<string> rLast = array.new_string()
var array<color>  rCol  = array.new_color()
var array<string> rWatch = array.new_string()
string msgs = ""
if barstate.islast
    rWatch.clear()
    rName.clear()
    rBuy.clear()
    rSell.clear()
    rLast.clear()
    rCol.clear()

// handles one symbol: remembers the last signal, collects alert text and table rows
check(int idx, string sym, bool used, bool bSig, float bE, float bSL, float bTP, bool sSig, float sE, float sSL, float sTP, int bP, int sP, int tm) =>
    // only count a signal once, on the bar where that stock actually printed a new candle
    isNew = na(tm[1]) or tm != tm[1]
    bS = bSig and isNew
    sS = sSig and isNew
    string m = ""
    if used
        name = shortName(sym)
        if bS
            lastTxt.set(idx, "BUY " + fmt(bE))
            lastBar.set(idx, bar_index)
            if alertBuy
                m := "BUY " + name + " | Entry " + fmt(bE) + " | SL " + fmt(bSL) + " | TP " + fmt(bTP) + "\n"
        if sS
            lastTxt.set(idx, "SELL " + fmt(sE))
            lastBar.set(idx, bar_index)
            if alertSell
                m := m + "SELL " + name + " | Entry " + fmt(sE) + " | SL " + fmt(sSL) + " | TP " + fmt(sTP) + "\n"
        if barstate.islast
            lb = lastBar.get(idx)
            int ago = na(lb) ? na : bar_index - lb
            recent = not na(ago) and ago <= recentBars
            active = (not na(bP) and bP > 0) or (not na(sP) and sP > 0)
            // close to a signal = BOS done or waiting for the FVG retrace
            if not na(bP) and bP >= 3 and not bS
                rWatch.push(name + " (BUY, " + phaseText(bP) + ")")
            if not na(sP) and sP >= 3 and not sS
                rWatch.push(name + " (SELL, " + phaseText(sP) + ")")
            if showAll or active or recent or bS or sS
                rName.push(name)
                rBuy.push(bS ? "BUY NOW" : phaseText(bP))
                rSell.push(sS ? "SELL NOW" : phaseText(sP))
                lt = lastTxt.get(idx)
                rLast.push(na(ago) ? "-" : lt + " (" + str.tostring(ago) + " bars ago)")
                rCol.push(str.startswith(lt, "BUY") ? color.lime : str.startswith(lt, "SELL") ? color.red : color.gray)
    m

u01 = sym01 != ""
[b01, be01, bsl01, btp01, s01, se01, ssl01, stp01, bp01, sp01, t01] = request.security(u01 ? sym01 : syminfo.tickerid, timeframe.period, scan(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
msgs += check(0, sym01, u01, b01, be01, bsl01, btp01, s01, se01, ssl01, stp01, bp01, sp01, t01)
