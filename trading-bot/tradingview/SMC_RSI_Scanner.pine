// SMC + RSI Scanner — watches up to 40 stocks with ONE alert.
// Lists: "Saudi (Sahm)" = 40 most-traded Tadawul stocks, "US (Sahm)" = 40 popular US stocks (NASDAQ + NYSE only),
//        "Custom" = your own 40 (Settings -> Custom list).
// Tip: one alert per list. Saudi list -> create the alert on a Saudi chart (e.g. TADAWUL:2222);
//      then switch Market list to US, open a US chart (e.g. NASDAQ:AAPL) and create a second alert.
// Same rules as SMC_RSI_Signals.pine / the MT5 bot / the Python backtester.
// Signals only: you place the order with your broker (Sahm, Alinma, ...).
//
// Alert: Condition = SMC + RSI Scanner -> "Any alert() function call", Interval = 1 day.
//@version=6
indicator("SMC + RSI Scanner", overlay = true, max_bars_back = 500, calc_bars_count = 1500)

preset     = input.string("Saudi (Sahm)", "Market list", options = ["Saudi (Sahm)", "US (Sahm)", "Custom"])
showAll    = input.bool(false, "Show all stocks in the table (off = only active setups / recent signals)")
recentBars = input.int(10, "Count a signal as recent for N bars")
tblSizeIn  = input.string("Large", "Table size", options = ["Small", "Normal", "Large", "Huge"])
tblPosIn   = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"])
tblSize    = tblSizeIn == "Small" ? size.small : tblSizeIn == "Normal" ? size.normal : tblSizeIn == "Large" ? size.large : size.huge
tblPos     = tblPosIn == "Top left" ? position.top_left : tblPosIn == "Bottom right" ? position.bottom_right : tblPosIn == "Bottom left" ? position.bottom_left : tblPosIn == "Middle right" ? position.middle_right : position.top_right
swingLen   = input.int(3, "Swing length (bars each side)", minval = 1, group = "Strategy")
rsiLen     = input.int(14, "RSI period", group = "Strategy")
reqDiv     = input.bool(true, "Require RSI divergence at the sweep (video 1)", group = "Strategy")
reqBos     = input.bool(true, "Wait for BOS after CHoCH (video 2)", group = "Strategy")
rr         = input.float(2.0, "Reward : Risk", step = 0.5, group = "Strategy")
slBuf      = input.float(0.10, "Extra SL beyond sweep wick (x ATR)", step = 0.05, group = "Strategy")
maxSetup   = input.int(60, "Setup expires after N bars", group = "Strategy")
maxRiskAtr = input.float(6.0, "Skip if SL wider than N x ATR", group = "Strategy")
atrLen     = input.int(14, "ATR period", group = "Strategy")
alertBuy   = input.bool(true, "Alert on BUY", group = "Alerts")
alertSell  = input.bool(true, "Alert on SELL (exit if you hold the stock)", group = "Alerts")
dailyRep   = input.bool(true, "Daily report: send a summary every trading day", group = "Alerts")
